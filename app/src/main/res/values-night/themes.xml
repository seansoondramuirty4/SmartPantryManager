<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.SmartPantryManager" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Main application colours -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Dark background -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>

        <!-- Light text for dark mode -->
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>

        <!-- Status and navigation bars -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>

    </style>

</resources>