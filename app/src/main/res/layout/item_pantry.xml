<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/pantry_item_background">

    <TextView
        android:id="@+id/ingredientNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredient Name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/primary" />

    <TextView
        android:id="@+id/ingredientDetailsTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantity: 0 | Unit: unit"
        android:textSize="15sp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/expiryDateTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expiry: Not specified"
        android:textSize="14sp"
        android:layout_marginTop="3dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/editButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit"
            android:textAllCaps="false"
            android:background="@drawable/button_background" />

        <Button
            android:id="@+id/deleteButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delete"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_background" />

    </LinearLayout>

</LinearLayout>
